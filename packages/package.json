{
  "name": "anythingllm-packages",
  "private": true,
  "description": "The JavaScript parts, the bridge, the control server and the skills: one install of the toolchain, one tsconfig, one build script. CommonJS by default, which the skills need (AnythingLLM requires them); the bridge's and the control server's source, the shared helpers and the tests are .mts, so ESM by their extension.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "typecheck": "tsc -p .",
    "shared:test": "node --test --test-timeout=120000 --test-force-exit \"shared/*.test.mts\" \"*.test.mts\"",
    "bridge:test": "node build.mjs bridge && node --test --test-timeout=120000 \"bridge/tests/*.test.mts\"",
    "control:test": "node build.mjs control && node --test --test-timeout=120000 \"control/tests/*.test.mts\"",
    "skills:test": "node build.mjs skills && node --test --test-timeout=120000 --test-force-exit \"skills/*/tests/*.test.mts\""
  },
  "devDependencies": {
    "@jitl/quickjs-singlefile-cjs-release-sync": "0.32.0",
    "@types/node": "^18.19.130",
    "esbuild": "^0.28.2",
    "fast-json-patch": "3.1.1",
    "puppeteer-core": "24.43.1",
    "quickjs-emscripten-core": "0.32.0",
    "typescript": "^7.0.2"
  },
  "imports": {
    "#shared/*": "./shared/*.mts"
  }
}
