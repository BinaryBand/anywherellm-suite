#!/usr/bin/env bash
# tools/e2e-fence [BRIDGE_DIR]: the fence's asks across this checkout and anywherellm-bridge
# (docs/fence-lean.md). Runs the bridge's own tools/e2e (a throwaway AnythingLLM with the
# bridge served beside it, from the bridge checkout in BRIDGE_DIR, else $ANYWHERELLM_BRIDGE, else
# ../anywherellm-bridge beside this one) with tools/fence-lean.e2e.mts as its command, so this
# checkout's shared code and that bridge meet in one storage folder, as a skill and the bridge do.
# Everything is removed on the way out, as tools/e2e's.
set -euo pipefail
. "$(dirname "${BASH_SOURCE[0]}")/lib.sh"

bridge=${1:-${ANYWHERELLM_BRIDGE:-$ROOT/../anywherellm-bridge}}
[ -x "$bridge/tools/e2e" ] || {
  echo "${0##*/}: no anywherellm-bridge checkout at $bridge (pass its folder, or set ANYWHERELLM_BRIDGE)" >&2
  exit 2
}
exec "$bridge/tools/e2e" node --test "$ROOT/tools/fence-lean.e2e.mts"
