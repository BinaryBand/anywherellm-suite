#!/usr/bin/env bash
# tools/check [install|control|skills ...]: the tests of each part; no argument: all, stopping at
# the first part that fails. Their type-check and the tests of what they share (packages/shared,
# the build script) run once, first; then the parts are built, once, and each part's tests run.
set -euo pipefail
. "$(dirname "${BASH_SOURCE[0]}")/lib.sh"

[ $# -gt 0 ] || set -- install control skills
for part in "$@"; do
  case "$part" in
    install|control|skills) ;;
    *) echo "tools/check: no such part: $part (one of: install control skills)" >&2; exit 2 ;;
  esac
done
echo "[shared] type-check, then tests"
npm --prefix "$ROOT/packages" run -s typecheck
npm --prefix "$ROOT/packages" run -s shared:test
case " $* " in
  *" install "*) node "$ROOT/packages/build.mjs" ;; # the installer carries the others, so it builds them all
  *) for part in "$@"; do node "$ROOT/packages/build.mjs" "$part"; done ;;
esac
for part in "$@"; do
  echo "[$part] tests"
  npm --prefix "$ROOT/packages" run -s "$part:unit"
done
