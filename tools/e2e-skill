#!/usr/bin/env bash
# tools/e2e-skill [skill ...]: a skill's own check inside a real AnythingLLM. For each skill (no
# argument: every skill with a tests/e2e/inside.js) it starts a throwaway AnythingLLM (the image in
# contract/versions.env) on fresh storage, installs the built skill with `anywherellm-suite install
# --skills` (and a browser-extension key it made, --page-key), and runs the skill's tests/e2e/inside.js in the container. The container and the
# temporary folder are removed afterwards, pass or fail; nothing running on this machine is touched.
#
# Fresh storage matters: a folder left from an earlier run has tabs whose pages are gone. (Not
# tools/e2e, which drives the control server and the bridge.) Needs podman or docker and Node 22.18
# or later; the first run pulls the image.
set -euo pipefail
. "$(dirname "${BASH_SOURCE[0]}")/lib.sh"
need_engine

# up: AnythingLLM has set its database up and answers. "Primary server" in its log says so; before
# that a skill's first run fails on missing tables, which /api/ping alone doesn't tell.
up() {
  local log
  log=$("$engine" logs "$name" 2>&1) && [[ $log == *"Primary server"* ]] && curl -fs "http://127.0.0.1:$port/api/ping"
}

# e2e <skill>: one skill. Run in a subshell, so its variables and its exit trap are its own.
e2e() {
  load_skill "$1"
  [ -f "$SKILL_DIR/tests/e2e/inside.js" ] || { echo "tools/e2e-skill: $1 has no tests/e2e/inside.js" >&2; exit 1; }
  name="allm-e2e-skill-$1-$$"
  work=$(mktemp -d)
  port=$(free_port)
  trap 'status=$?
    [ "$status" -eq 0 ] || { echo "--- the container log" >&2; "$engine" logs --tail 20 "$name" >&2 2>&1 || true; }
    open_storage
    "$engine" stop -t 1 "$name" >/dev/null 2>&1 || true
    rm -rf "$work"
    exit "$status"' EXIT

  mkdir "$work/storage"
  echo "[e2e-skill] $1: AnythingLLM ($IMAGE) on :$port, its storage in $work/storage"
  # shellcheck disable=SC2086 # the podman flag is one word, or nothing
  "$engine" run -d --rm --name "$name" -p "127.0.0.1:$port:$INNER_PORT" ${podman:+--userns=keep-id:uid=1000,gid=1000} \
    -v "$work/storage:$INNER_STORAGE" -v "$SKILL_DIR/tests/e2e:/e2e:ro,Z" -e STORAGE_DIR="$INNER_STORAGE" \
    -e JWT_SECRET="$(head -c 18 /dev/urandom | base64 | tr -dc 'A-Za-z0-9')" "$IMAGE" >/dev/null
  wait_until "AnythingLLM" up
  open_storage

  # The pages' key, as Settings > Browser Extension makes one (this AnythingLLM has no password).
  page_key=$(curl -fs -X POST "http://127.0.0.1:$port/api/browser-extension/api-keys/new" | json 'j.apiKey')
  BRIDGE_ENV_FILE="$work/bridge.env" node "$cli" install --storage "$work/storage" --skills "$1" --page-key "$page_key"
  "$engine" exec -w /app/server -e HUB_ID="$HUB_ID" -e STORAGE_DIR="$INNER_STORAGE" -e INNER_PORT="$INNER_PORT" \
    -e FENCE_ALLOW=127.0.0.1,localhost "$name" node /e2e/inside.js
  echo "tools/e2e-skill: $1 ok"
}

[ $# -gt 0 ] || set -- $(for s in $(skills); do [ -f "$ROOT/packages/skills/$s/tests/e2e/inside.js" ] && echo "$s"; done)
echo "[e2e-skill] anywherellm-suite, built from packages/"
(cd "$ROOT/packages" && node build.mjs bridge >/dev/null)
cli="$ROOT/packages/bridge/dist/anywherellm-suite.cjs"
for skill in "$@"; do (e2e "$skill"); done
